{
  "name": "@icco/writing",
  "version": "9.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "content-collections build && next build",
    "content:build": "content-collections build",
    "chrome": "playwright install --with-deps chromium",
    "dev:content": "content-collections watch",
    "dev:next": "next dev -p 8080",
    "dev": "run-p dev:*",
    "prepare-posts": "tsx prepare-posts.ts",
    "lint": "eslint --fix .",
    "lint:spell": "misspell -locale US -w ./posts/",
    "start": "next start -p $PORT",
    "clean": "rm -rf node_modules .next .content-collections",
    "tw": "tailwindcss -i src/app/globals.css",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "webmentions:send": "tsx scripts/send-webmentions.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@heroicons/react": "^2.2.0",
    "@icco/react-common": "^2026.11104.1",
    "@mdx-js/mdx": "^3.1.1",
    "@opentelemetry/api": "~1.10.0",
    "@wooorm/starry-night": "^3.11.0",
    "date-fns": "^4.4.0",
    "feed": "^6.0.0",
    "got": "^16.2.0",
    "gray-matter": "^4.0.3",
    "http-link-header": "^1.1.4",
    "ipaddr.js": "^2.5.0",
    "jsdom": "^30.1.3",
    "mdast-util-find-and-replace": "^3.0.4",
    "next": "^16.4.5",
    "next-secure-headers": "^2.2.0",
    "playwright": "^1.65.0",
    "pluralize": "^8.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reading-time": "^1.5.0",
    "rehype-github-emoji": "^1.0.0",
    "rehype-mermaid": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-starry-night": "^2.2.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "strip-markdown": "^6.0.0",
    "unified": "^11.0.5",
    "whatwg-mimetype": "^5.0.0",
    "write-file-atomic": "^8.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@content-collections/cli": "^0.1.9",
    "@content-collections/core": "^0.15.3",
    "@next/eslint-plugin-next": "^16.4.5",
    "@tailwindcss/cli": "^4.3.4",
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/http-link-header": "^1.0.7",
    "@types/jsdom": "^30.0.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/whatwg-mimetype": "^5.0.0",
    "@types/write-file-atomic": "^4.0.3",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "daisyui": "^5.7.50",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "microformats-parser": "^2.0.6",
    "nock": "^15.0.6",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": false,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "singleQuote": false
  }
}
