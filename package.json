{
  "name": "@icco/writing",
  "version": "9.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "contentlayer2 build && next build",
    "contentlayer:build": "contentlayer2 build",
    "chrome": "playwright install --with-deps chromium",
    "dev:contentlayer": "contentlayer2 dev",
    "dev:next": "next dev -p 8080",
    "dev": "run-p dev:*",
    "prepare-posts": "tsx prepare-posts.ts",
    "lint": "eslint --fix .",
    "lint:spell": "misspell -locale US -w ./posts/",
    "start": "next start -p $PORT",
    "clean": "rm -rf node_modules .next .contentlayer",
    "tw": "tailwindcss -i src/app/globals.css",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@heroicons/react": "^2.2.0",
    "@icco/react-common": "^2026.11029.1",
    "@opentelemetry/api": "~1.9.1",
    "@wooorm/starry-night": "^3.11.0",
    "contentlayer2": "^0.5.8",
    "date-fns": "^4.4.0",
    "feed": "^6.0.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^30.1.3",
    "mdast-util-find-and-replace": "^3.0.4",
    "next": "^16.4.3",
    "next-contentlayer2": "^0.5.8",
    "next-secure-headers": "^2.2.0",
    "playwright": "^1.64.1",
    "pluralize": "^8.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reading-time": "^1.5.0",
    "rehype-github-emoji": "^1.0.0",
    "rehype-mermaid": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-starry-night": "^2.2.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "strip-markdown": "^6.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.3",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "daisyui": "^5.7.50",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": false,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "singleQuote": false
  }
}
